# Copy to .env. Never commit real values.
BOT_TOKEN=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
DEVELOPER_ADMIN_ID=0

# Main contacts/documents database and admin authentication database
CONTACTS_DB_PATH=universal_contacts.db
DB_PATH=bot.db

# Generate a unique key with the command in README.md
SESSION_ENCRYPTION_KEY=

# Use an HTTPS reverse proxy for remote access
WEB_AUTH_HOST=127.0.0.1
WEB_AUTH_PORT=8081
WEB_AUTH_BASE_URL=http://127.0.0.1:8081
